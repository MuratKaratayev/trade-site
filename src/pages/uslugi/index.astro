---
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import { services, platforms } from '../../data/site';

const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

// Простые иконки этапов (stroke, 24×24)
const icons: Record<string, string> = {
  obsledovanie: '<circle cx="11" cy="11" r="6"/><path d="M20 20l-4.2-4.2"/>',
  proektirovanie: '<path d="M4 20h16M6 16l9-9 3 3-9 9H6v-3z"/>',
  postavka: '<path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/>',
  shkafy: '<rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M12 3v18M9 9v2M15 9v2"/>',
  smr: '<path d="M14 6l4 4M4 20l9-9M15.5 3.5l5 5-3 3-5-5z"/>',
  servis: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1L7 17M17 7l2.1-2.1"/>',
};
---
<Base
  title="Услуги — TRADE-Инжиниринг"
  description="Предпроектное обследование, проектирование, поставка КИПиА, изготовление шкафов автоматики, монтаж, пусконаладка и сервис систем АСУ ТП."
>
  <section class="page-hero" aria-labelledby="page-title">
    <div class="wrap">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Услуги</span>
      </nav>
      <div class="page-hero__grid">
        <h1 id="page-title" class="page-hero__in">Услуги</h1>
        <p class="page-hero__in" style="--i:2">
          Ведём проект автоматизации от&nbsp;выезда на&nbsp;объект до&nbsp;гарантийного обслуживания. Можно заказать весь цикл или отдельный этап.
        </p>
      </div>
      <ol class="toc page-hero__in" style="--i:3">
        {
          services.map((s, i) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="mono">{String(i + 1).padStart(2, '0')}</span> {s.title}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section services-wrap" aria-label="Перечень услуг">
    <div class="wrap services">
      <div class="services__list">
        {
          services.map((s, i) => (
            <article class="service" id={s.id} data-reveal>
              <div class="service__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={icons[s.id]} />
              </div>
              <div class="service__body">
                <span class="service__n">Этап {String(i + 1).padStart(2, '0')}</span>
                <h2>{s.title}</h2>
                <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
              </div>
            </article>
          ))
        }
      </div>

      <aside class="services__aside">
        <div class="aside-card" data-reveal>
          <h2>Нужен расчёт?</h2>
          <p>Опишите объект и&nbsp;задачу — подготовим технические решения и&nbsp;бюджетную оценку.</p>
          <a class="btn btn--primary" href="#contact">Оставить заявку <Fragment set:html={arrow} /></a>
          <div class="aside-card__platforms">
            <span>Платформы</span>
            <ul>{platforms.map((p) => <li>{p}</li>)}</ul>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <Contact />
</Base>

<style>
  .page-hero {
    padding-block: clamp(32px, 5vw, 64px) clamp(48px, 6vw, 80px);
    border-bottom: 1px solid var(--line);
  }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 14px;
    color: var(--muted);
    margin-bottom: clamp(24px, 4vw, 48px);
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .page-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 48px;
    align-items: end;
  }
  h1 {
    font-size: clamp(48px, 9vw, 120px);
    letter-spacing: -0.045em;
    line-height: 0.95;
  }
  .page-hero__grid p {
    font-size: clamp(18px, 1.7vw, 21px);
    color: var(--muted);
    max-width: 520px;
  }
  .page-hero__in {
    animation: fade-up 0.9s var(--ease) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }
  .toc {
    list-style: none;
    margin: clamp(32px, 5vw, 56px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }
  .toc a {
    display: flex;
    gap: 12px;
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--line);
    transition: color 0.2s, padding 0.3s var(--ease);
  }
  .toc a:hover {
    color: var(--accent);
    padding-left: 8px;
  }
  .mono {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    padding-top: 3px;
  }

  .services {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .services__list {
    display: grid;
    gap: 20px;
  }
  .service {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 24px;
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    scroll-margin-top: 100px;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .service:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }
  .service:target {
    border-color: var(--accent);
  }
  .service__icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .service__icon svg {
    width: 30px;
    height: 30px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .service:hover .service__icon svg {
    animation: nudge 0.6s var(--ease);
  }
  .service__n {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .service h2 {
    font-size: clamp(22px, 2.4vw, 30px);
    margin: 6px 0 16px;
  }
  .service ul {
    display: grid;
    gap: 8px;
  }
  .service li {
    position: relative;
    padding-left: 22px;
    color: var(--muted);
  }
  .service li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 10px;
    height: 2px;
    background: var(--accent);
  }

  .services__aside {
    position: sticky;
    top: 100px;
  }
  .aside-card {
    display: grid;
    gap: 16px;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--text);
    color: var(--bg);
  }
  .aside-card h2 {
    font-size: 28px;
  }
  .aside-card p {
    opacity: 0.75;
  }
  .aside-card .btn {
    justify-self: start;
  }
  .aside-card__platforms {
    margin-top: 12px;
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, var(--bg) 25%, transparent);
    display: grid;
    gap: 10px;
  }
  .aside-card__platforms span {
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.6;
  }
  .aside-card__platforms ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .aside-card__platforms li {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--bg) 35%, transparent);
    font-size: 14px;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nudge {
    50% {
      transform: translateY(-3px) rotate(-6deg);
    }
  }

  @media (max-width: 1000px) {
    .services {
      grid-template-columns: 1fr;
    }
    .services__aside {
      position: static;
    }
    .toc {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .page-hero__grid {
      grid-template-columns: 1fr;
    }
    .toc {
      grid-template-columns: 1fr;
    }
    .service {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .service__icon {
      width: 52px;
      height: 52px;
    }
  }
</style>
