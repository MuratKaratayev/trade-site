---
import { company } from '../data/site';
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact__grid">
    <div class="contact__info" data-reveal>
      <span class="eyebrow">Контакты</span>
      <h2 id="contact-title">Расскажите о&nbsp;задаче — подготовим решение и&nbsp;бюджетную оценку</h2>
      <dl>
        <div>
          <dt>Телефоны</dt>
          <dd>{company.phones.map((p) => <a class="mono" href={p.href}>{p.label}</a>)}</dd>
        </div>
        <div>
          <dt>Почта</dt>
          <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
        </div>
        <div>
          <dt>Адрес</dt>
          <dd>{company.address}</dd>
        </div>
      </dl>
    </div>

    <form class="contact__form" data-reveal style="--d:2" data-demo-form novalidate>
      <div class="field">
        <label for="f-name">Имя</label>
        <input id="f-name" name="name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="f-phone">Телефон</label>
        <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+7" required />
      </div>
      <div class="field">
        <label for="f-company">Компания <span>необязательно</span></label>
        <input id="f-company" name="company" autocomplete="organization" />
      </div>
      <div class="field">
        <label for="f-msg">Задача <span>необязательно</span></label>
        <textarea id="f-msg" name="message" rows="4"></textarea>
      </div>
      <label class="check">
        <input type="checkbox" name="consent" required />
        <span>Согласен на обработку персональных данных</span>
      </label>
      <button class="btn btn--primary" type="submit">Отправить заявку</button>
      <p class="contact__status" role="status" aria-live="polite" data-status></p>
    </form>
  </div>
</section>

<style>
  .contact {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
  }
  .contact__info {
    display: grid;
    gap: 24px;
    align-content: start;
  }
  h2 {
    font-size: clamp(30px, 3.8vw, 46px);
  }
  dl {
    display: grid;
    gap: 20px;
    margin: 16px 0 0;
  }
  dt {
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin-bottom: 4px;
  }
  dd {
    margin: 0;
    display: grid;
    gap: 2px;
  }
  dd a:hover {
    color: var(--accent);
  }
  .mono {
    font-family: var(--mono);
  }
  .contact__form {
    display: grid;
    gap: 18px;
    padding: clamp(20px, 3vw, 36px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .field {
    display: grid;
    gap: 6px;
  }
  label {
    font-size: 14px;
    font-weight: 550;
  }
  label span {
    font-weight: 400;
    color: var(--muted);
  }
  input:not([type='checkbox']),
  textarea {
    width: 100%;
    font: inherit;
    font-size: 16px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .is-invalid {
    border-color: var(--accent) !important;
  }
  textarea {
    resize: vertical;
  }
  .check {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-weight: 400;
    color: var(--muted);
  }
  .check input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--accent);
  }
  .contact__form .btn {
    justify-self: start;
  }
  .contact__status {
    font-size: 14px;
    color: var(--muted);
    min-height: 1.4em;
  }
  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
    .contact__form .btn {
      justify-self: stretch;
    }
  }
</style>

<script>
  // ПРОТОТИП: форма никуда не отправляет данные. Бэкенд (почта / Telegram / CRM) — отдельная задача.
  document.querySelectorAll<HTMLFormElement>('[data-demo-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let ok = true;
      form.querySelectorAll<HTMLInputElement>('[required]').forEach((el) => {
        const bad = el.type === 'checkbox' ? !el.checked : !el.value.trim();
        el.classList.toggle('is-invalid', bad);
        if (bad) ok = false;
      });
      if (status) {
        status.textContent = ok
          ? 'Это прототип: заявка не отправлена. Отправка будет подключена в рабочей версии сайта.'
          : 'Заполните имя, телефон и отметьте согласие.';
      }
    });
  });
</script>
