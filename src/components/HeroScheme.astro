---
// Анимированная схема «поле → контроллер → SCADA».
// Значения на схеме — ДЕКОРАТИВНЫЕ (случайное блуждание вокруг базового значения), не реальные данные.

const field = [
  { id: 'pt', x: 70, tag: 'PT-101', kind: 'sensor', label: 'Давление', unit: 'МПа', base: 4.12, spread: 0.06, digits: 2, path: 'M70 404 V372 H232 V328' },
  { id: 'ft', x: 210, tag: 'FT-102', kind: 'sensor', label: 'Расход', unit: 'м³/ч', base: 318, spread: 6, digits: 0, path: 'M210 404 V372 H256 V328' },
  { id: 'te', x: 350, tag: 'TE-103', kind: 'sensor', label: 'Температура', unit: '°C', base: 87.4, spread: 0.8, digits: 1, path: 'M350 404 V372 H304 V328' },
  { id: 'fv', x: 490, tag: 'FV-104', kind: 'valve', label: 'Клапан', unit: '%', base: 62, spread: 3, digits: 0, path: 'M490 404 V372 H328 V328' },
] as const;

const slots = Array.from({ length: 8 }, (_, i) => i);
---
<figure class="scheme" data-scheme>
  <svg viewBox="0 0 560 500" role="img" aria-labelledby="scheme-title">
    <title id="scheme-title">Схема: датчики передают сигналы в контроллер, контроллер — в систему диспетчеризации SCADA</title>
    <defs>
      <pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" class="dot" />
      </pattern>
      <linearGradient id="trend-fill" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="var(--accent)" stop-opacity=".28" />
        <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
      </linearGradient>
    </defs>

    <rect width="560" height="500" fill="url(#dots)" />

    <!-- Провода -->
    <g class="wires" fill="none">
      <path class="wire" pathLength="1" d="M280 168 V232" style="--w:0" />
      {field.map((f, i) => <path class="wire" pathLength="1" d={f.path} style={`--w:${i + 1}`} />)}
    </g>

    <!-- SCADA -->
    <g class="node" style="--n:5">
      <rect x="140" y="16" width="280" height="152" rx="12" class="box" />
      <rect x="140" y="16" width="280" height="30" rx="12" class="box-head" />
      <rect x="140" y="34" width="280" height="12" class="box-head" />
      <circle cx="158" cy="31" r="3.5" class="led led--ok" />
      <text x="170" y="35" class="t-mono t-sm">SCADA · операторская</text>
      <text x="404" y="35" class="t-mono t-sm t-muted" text-anchor="end" data-clock>00:00:00</text>
      <line x1="156" y1="140" x2="404" y2="140" class="grid-line" />
      <line x1="156" y1="110" x2="404" y2="110" class="grid-line" />
      <line x1="156" y1="80" x2="404" y2="80" class="grid-line" />
      <path d="" fill="url(#trend-fill)" data-trend-area />
      <polyline points="" class="trend" data-trend />
      <text x="156" y="160" class="t-mono t-xs t-muted">PT-101, МПа — тренд 60 с</text>
    </g>

    <text x="292" y="204" class="t-mono t-xs t-muted">Ethernet · Modbus TCP</text>

    <!-- Контроллер -->
    <g class="node" style="--n:6">
      <rect x="170" y="232" width="220" height="96" rx="10" class="box" />
      <text x="186" y="254" class="t-mono t-sm">Контроллер TREI-5B</text>
      {
        slots.map((i) => (
          <g>
            <rect x={186 + i * 24} y={264} width="18" height="52" rx="3" class="slot" />
            <circle cx={195 + i * 24} cy={274} r="2.6" class="led led--blink" style={`--b:${(i * 0.37) % 1.6}s`} />
          </g>
        ))
      }
    </g>

    <text x="18" y="364" class="t-mono t-xs t-muted">4–20 мА</text>

    <!-- Полевые приборы -->
    {
      field.map((f, i) => (
        <g class="node" style={`--n:${i + 1}`}>
          {f.kind === 'sensor' ? (
            <>
              <circle cx={f.x} cy="422" r="18" class="box" />
              <text x={f.x} y="426" class="t-mono t-xs" text-anchor="middle">{f.tag.slice(0, 2)}</text>
            </>
          ) : (
            <>
              <path d={`M${f.x - 18} 410 L${f.x + 18} 434 V410 L${f.x - 18} 434 Z`} class="box" />
              <path d={`M${f.x} 422 V404`} class="stem" />
            </>
          )}
          <text x={f.x} y="460" class="t-mono t-sm" text-anchor="middle">{f.tag}</text>
          <text x={f.x} y="480" class="t-mono t-sm t-accent" text-anchor="middle">
            <tspan data-val={f.id} data-base={f.base} data-spread={f.spread} data-digits={f.digits}>{f.base.toFixed(f.digits)}</tspan> {f.unit}
          </text>
        </g>
      ))
    }

    <!-- Сигналы, бегущие по проводам. Датчики → контроллер; контроллер → клапан (обратное направление). -->
    <g class="pulses">
      {
        field.map((f, i) => (
          <circle r="4" class="pulse">
            <animateMotion
              dur="2.2s"
              begin={`${1.8 + i * 0.45}s`}
              repeatCount="indefinite"
              path={f.path}
              keyPoints={f.kind === 'valve' ? '1;0' : '0;1'}
              keyTimes="0;1"
              calcMode="linear"
            />
          </circle>
        ))
      }
      <circle r="4" class="pulse">
        <animateMotion dur="1.4s" begin="2.2s" repeatCount="indefinite" path="M280 232 V168" />
      </circle>
      <circle r="4" class="pulse pulse--down">
        <animateMotion dur="1.4s" begin="2.9s" repeatCount="indefinite" path="M280 168 V232" />
      </circle>
    </g>
  </svg>
</figure>

<style>
  .scheme {
    margin: 0;
    width: 100%;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .dot {
    fill: var(--line-strong);
    opacity: 0.55;
  }
  .wire {
    stroke: var(--line-strong);
    stroke-width: 1.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.1s var(--ease) forwards;
    animation-delay: calc(0.5s + var(--w) * 0.12s);
  }
  .box {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 1.4;
  }
  .box-head {
    fill: var(--surface-2);
  }
  .stem {
    stroke: var(--line-strong);
    stroke-width: 1.4;
  }
  .slot {
    fill: var(--surface-2);
    stroke: var(--line);
  }
  .grid-line {
    stroke: var(--line);
    stroke-dasharray: 2 4;
  }
  .trend {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .led {
    fill: var(--signal);
  }
  .led--blink {
    animation: blink 1.6s steps(1) infinite;
    animation-delay: var(--b);
  }
  .node {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: pop 0.7s var(--ease) forwards;
    animation-delay: calc(0.15s + var(--n) * 0.1s);
  }
  .pulse {
    fill: var(--accent);
    filter: drop-shadow(0 0 4px var(--accent));
  }
  .pulse--down {
    fill: var(--signal);
    filter: drop-shadow(0 0 4px var(--signal));
  }
  text {
    fill: var(--text);
  }
  .t-mono {
    font-family: var(--mono);
  }
  .t-sm {
    font-size: 12px;
  }
  .t-xs {
    font-size: 10.5px;
  }
  .t-muted {
    fill: var(--muted);
  }
  .t-accent {
    fill: var(--accent);
    font-weight: 600;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulses {
      display: none;
    }
    .wire {
      stroke-dashoffset: 0;
    }
    .node {
      opacity: 1;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-scheme]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root) {
    const vals = [...root.querySelectorAll<SVGTSpanElement>('[data-val]')];
    const state = vals.map((el) => Number(el.dataset.base));
    const trend = root.querySelector<SVGPolylineElement>('[data-trend]');
    const area = root.querySelector<SVGPathElement>('[data-trend-area]');
    const clock = root.querySelector<SVGTextElement>('[data-clock]');

    // Тренд: 32 точки в окне x 156..404, y 62..138
    const N = 32;
    const x0 = 156, x1 = 404, yTop = 62, yBot = 138;
    const pt = vals.findIndex((v) => v.dataset.val === 'pt');
    const base = state[pt] ?? 4.12;
    const spread = Number(vals[pt]?.dataset.spread ?? 0.06);
    let series = Array.from({ length: N }, (_, i) => base + Math.sin(i / 3) * spread * 0.6);

    const draw = () => {
      const min = base - spread * 2, max = base + spread * 2;
      const pts = series.map((v, i) => {
        const x = x0 + ((x1 - x0) * i) / (N - 1);
        const y = yBot - ((v - min) / (max - min)) * (yBot - yTop);
        return [x, Math.max(yTop, Math.min(yBot, y))];
      });
      trend?.setAttribute('points', pts.map((p) => p.join(',')).join(' '));
      area?.setAttribute('d', `M${x0},${yBot} L${pts.map((p) => p.join(',')).join(' L')} L${x1},${yBot} Z`);
    };

    const tick = () => {
      vals.forEach((el, i) => {
        const b = Number(el.dataset.base);
        const s = Number(el.dataset.spread);
        // Случайное блуждание с притяжением к базовому значению
        state[i] += (Math.random() - 0.5) * s * 0.8 + (b - state[i]) * 0.25;
        el.textContent = state[i].toFixed(Number(el.dataset.digits));
      });
      series = [...series.slice(1), state[pt] ?? base];
      draw();
      if (clock) clock.textContent = new Date().toLocaleTimeString('ru-RU');
    };

    draw();
    if (clock) clock.textContent = new Date().toLocaleTimeString('ru-RU');

    if (!reduce) {
      let timer = 0;
      // Не крутим таймер, когда схема вне экрана или вкладка скрыта
      const io = new IntersectionObserver(([e]) => {
        window.clearInterval(timer);
        if (e.isIntersecting) timer = window.setInterval(tick, 1100);
      });
      io.observe(root);
    }
  }
</script>
