---
// Переключатель темы: система / светлая / тёмная.
// Начальное значение выставляется inline-скриптом в Base.astro (до отрисовки, без мигания).
const options = [
  { value: 'system', label: 'Как в системе' },
  { value: 'light', label: 'Светлая тема' },
  { value: 'dark', label: 'Тёмная тема' },
] as const;
---
<div class="theme-toggle" role="radiogroup" aria-label="Тема оформления" data-theme-toggle>
  {
    options.map((o) => (
      <button type="button" role="radio" aria-checked="false" data-value={o.value} title={o.label}>
        <span class="visually-hidden">{o.label}</span>
        {o.value === 'system' && (
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
        )}
        {o.value === 'light' && (
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        )}
        {o.value === 'dark' && (
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z" /></svg>
        )}
      </button>
    ))
  }
</div>

<style>
  .theme-toggle {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }
  button {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  button:hover {
    color: var(--text);
  }
  button[aria-checked='true'] {
    background: var(--surface-2);
    color: var(--text);
  }
  svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<script>
  const KEY = 'theme';
  type Mode = 'system' | 'light' | 'dark';

  function read(): Mode {
    try {
      const v = localStorage.getItem(KEY);
      if (v === 'light' || v === 'dark') return v;
    } catch {}
    return 'system';
  }

  function apply(mode: Mode) {
    const root = document.documentElement;
    if (mode === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', mode);
    try {
      if (mode === 'system') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, mode);
    } catch {}
    document.querySelectorAll<HTMLElement>('[data-theme-toggle] button').forEach((b) => {
      const on = b.dataset.value === mode;
      b.setAttribute('aria-checked', String(on));
      b.tabIndex = on ? 0 : -1;
    });
  }

  document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((group) => {
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('button')];
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => apply(b.dataset.value as Mode));
      // Стрелки — как в нативной radiogroup
      b.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = buttons[(i + step + buttons.length) % buttons.length];
        apply(next.dataset.value as Mode);
        next.focus();
      });
    });
  });

  apply(read());
</script>
