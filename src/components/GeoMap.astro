---
import { sites } from '../data/site';

// Простая равнопромежуточная проекция по рамке Казахстана (≈46–88° в. д., 40–56° с. ш.).
// Это схема, а не карта: границ нет, точки — центры городов.
const W = 880, H = 500;
const LON0 = 46, LON1 = 88, LAT0 = 40, LAT1 = 56;
const project = (lat: number, lon: number) => ({
  x: Math.round(((lon - LON0) / (LON1 - LON0)) * W),
  y: Math.round(((LAT1 - lat) / (LAT1 - LAT0)) * H),
});

// Подписи для близко стоящих городов разводим вручную
const labelPos: Record<string, { dx: number; dy: number; anchor: 'start' | 'end' }> = {
  Павлодар: { dx: 14, dy: -8, anchor: 'start' },
  Аксу: { dx: 14, dy: 14, anchor: 'start' },
  Экибастуз: { dx: -14, dy: 4, anchor: 'end' },
};

const hq = sites.find((s) => s.hq)!;
const hqP = project(hq.lat, hq.lon);
const points = sites.map((s, i) => {
  const p = project(s.lat, s.lon);
  const l = labelPos[s.city] ?? { dx: 14, dy: 5, anchor: 'start' as const };
  // Дуга от штаб-квартиры: контрольная точка приподнята над серединой отрезка
  const mx = (hqP.x + p.x) / 2;
  const my = (hqP.y + p.y) / 2 - Math.hypot(p.x - hqP.x, p.y - hqP.y) * 0.28;
  return { ...s, ...p, l, i, arc: s.hq ? null : `M${hqP.x} ${hqP.y} Q${mx} ${my} ${p.x} ${p.y}` };
});
---
<div class="geo" data-geo>
  <div class="geo__map" data-reveal>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Схема расположения объектов компании в Казахстане">
      <defs>
        <pattern id="geo-dots" width="16" height="16" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.3" class="g-dot" />
        </pattern>
        <radialGradient id="geo-fade" cx="0.55" cy="0.42" r="0.6">
          <stop offset="0.55" stop-color="#fff" />
          <stop offset="1" stop-color="#000" />
        </radialGradient>
        <mask id="geo-mask"><rect width={W} height={H} fill="url(#geo-fade)" /></mask>
      </defs>
      <rect width={W} height={H} fill="url(#geo-dots)" mask="url(#geo-mask)" />

      <g class="arcs">
        {points.filter((p) => p.arc).map((p) => <path class="arc" pathLength="1" d={p.arc!} data-city={p.city} style={`--i:${p.i}`} />)}
      </g>

      {
        points.map((p) => (
          <g class:list={['site', { 'site--hq': p.hq }]} data-city={p.city} style={`--i:${p.i}`}>
            <circle cx={p.x} cy={p.y} r={p.hq ? 22 : 14} class="site__ring" />
            <circle cx={p.x} cy={p.y} r={p.hq ? 7 : 5} class="site__dot" />
            <text x={p.x + p.l.dx} y={p.y + p.l.dy} text-anchor={p.l.anchor} class="site__label">
              {p.city}
            </text>
          </g>
        ))
      }
    </svg>
    <p class="geo__note">Схема: точки — города, где расположены объекты. Не в масштабе карты.</p>
  </div>

  <ul class="geo__list">
    {
      sites.map((s, i) => (
        <li data-reveal style={`--d:${i}`}>
          <div class="geo__item" data-city={s.city}>
            <span class="geo__city">
              {s.city}
              {s.hq && <em>офис</em>}
            </span>
            <span class="geo__objects">{s.objects.join(' · ')}</span>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .geo {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .geo__map {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: clamp(8px, 2vw, 24px);
  }
  .geo__map svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .geo__note {
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .g-dot {
    fill: var(--line-strong);
  }
  .arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.6;
    transition: opacity 0.3s, stroke-width 0.3s;
  }
  .is-live .arc {
    animation: geo-draw 1.4s var(--ease) forwards;
    animation-delay: calc(0.3s + var(--i) * 0.12s);
  }
  .site__dot {
    fill: var(--accent);
  }
  .site--hq .site__dot {
    fill: var(--text);
    stroke: var(--accent);
    stroke-width: 3;
  }
  .site__ring {
    fill: var(--accent);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .is-live .site__ring {
    animation: geo-ping 2.6s var(--ease) infinite;
    animation-delay: calc(1s + var(--i) * 0.3s);
  }
  .site__label {
    font-family: var(--mono);
    font-size: 15px;
    fill: var(--text);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 5px;
    stroke-linejoin: round;
    transition: fill 0.2s;
  }
  .site {
    transition: opacity 0.3s;
  }
  .geo.has-focus .site:not(.is-focus),
  .geo.has-focus .arc:not(.is-focus) {
    opacity: 0.2;
  }
  .site.is-focus .site__label {
    fill: var(--accent);
  }
  .arc.is-focus {
    opacity: 1;
    stroke-width: 2.5;
  }

  .geo__list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .geo__item {
    display: grid;
    gap: 4px;
    width: 100%;
    padding: 14px 4px;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.2s, padding 0.3s var(--ease);
  }
  .geo__item:hover {
    padding-left: 12px;
    background: var(--accent-soft);
  }
  .geo__city {
    font-weight: 600;
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .geo__city em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--accent);
    letter-spacing: 0.05em;
  }
  .geo__objects {
    font-size: 14px;
    color: var(--muted);
  }

  @keyframes geo-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes geo-ping {
    0% {
      opacity: 0.45;
      transform: scale(0.3);
    }
    80%,
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arc {
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 900px) {
    .geo {
      grid-template-columns: 1fr;
    }
    .site__label {
      font-size: 22px;
    }
  }
</style>

<script>
  const geo = document.querySelector<HTMLElement>('[data-geo]');
  if (geo) {
    // Анимация дуг стартует, когда карта попадает в экран
    new IntersectionObserver(
      ([e], obs) => {
        if (e.isIntersecting) {
          geo.classList.add('is-live');
          obs.disconnect();
        }
      },
      { threshold: 0.3 },
    ).observe(geo);

    // Наведение на город в списке подсвечивает его на схеме (чисто визуальный эффект)
    const focus = (city: string | null) => {
      geo.classList.toggle('has-focus', !!city);
      geo.querySelectorAll<SVGElement>('svg [data-city]').forEach((el) => {
        el.classList.toggle('is-focus', el.dataset.city === city);
      });
    };
    geo.querySelectorAll<HTMLElement>('.geo__item').forEach((el) => {
      el.addEventListener('mouseenter', () => focus(el.dataset.city ?? null));
      el.addEventListener('mouseleave', () => focus(null));
    });
  }
</script>
